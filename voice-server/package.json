{
  "name": "offline-reader-voice-server",
  "version": "1.0.0",
  "private": true,
  "description": "Renders prepared-book audio for Offline Reader on a computer on the same network.",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "bench": "node bench.mjs",
    "test": "node --test test/*.test.mjs",
    "test:gpu": "python3 -m unittest discover -s gpu"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "kokoro-js": "1.2.1",
    "phonon-tts": "0.7.1"
  }
}
