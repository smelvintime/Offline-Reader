node_modules/
.DS_Store
.wrangler/
*.log

# Native packaging: the Capacitor app projects and the www/ bundle are
# generated on the Mac (docs/mobile/NATIVE_BUILD.md) and never committed.
# native/ — the or-zip plugin — IS committed, and so is package-lock.json
# (reproducible native builds). Root-anchored on purpose: an unanchored
# "ios/" would also swallow native/or-zip/ios/, the one native dir we keep.
/www/
/ios/
/android/

# Scratch copies @capacitor/assets reads (made from the committed master
# assets/icon-1024.png per NATIVE_BUILD.md).
assets/logo.png
assets/icon-only.png
assets/splash.png
assets/splash-dark.png

# Natural-voice weights, fetched into the build by
# scripts/fetch-voice-model.mjs so the phone never downloads them. ~90 MB is a
# download, not a commit (vendor/tts/README.md) — and a fresh clone that skips
# the fetch still works: the runtime falls back to downloading on first use.
/vendor/tts/models/
/vendor/tts/voices/
